# Copy to `.dev.vars` for local `wrangler dev`, and set the same values in
# production with `wrangler secret put <NAME>`.

# Bot token — powers presence (gateway) and basic profile (/users/:id).
# Discord Dev Portal > your app > Bot > Reset Token.
DISCORD_BOT_TOKEN=

# OPTIONAL user token — only used to read the RICH profile endpoint
# (Nitro/boost/quest/orb/gifting badges, connected accounts, bio, pronouns).
# WARNING: using a user token is self-botting and against Discord's ToS;
# it can get the account banned. Leave blank to run bot-token-only.
DISCORD_USER_TOKEN=

# OPTIONAL second user token. If set, rich profile fetches spread across both
# tokens and fail over on a 429, doubling the /profile rate-limit headroom.
# Same ToS warning applies — more accounts means more accounts at risk.
DISCORD_USER_TOKEN2=

# OPTIONAL third user token — extra headroom / backup if the first two are both
# cooling down from a 429. Same ToS warning.
DISCORD_USER_TOKEN3=

# =====================================================================
# Doughmination system API (/v2/plural, /v2/battery, /v2/counter)
# =====================================================================

# PluralKit system token (Authorization header for api.pluralkit.me).
SYSTEM_TOKEN=

# HMAC secret used to sign the JWT the API issues after an SSO login.
# REQUIRED in production — set to a long random string, e.g.
# `openssl rand -base64 48`.
JWT_SECRET=

# Cloudflare Turnstile secret (public guestbook captcha).
TURNSTILE_SECRET=

# ---- Doughmination SSO (OpenID Connect) — the ONLY login method -------------
# In the SSO admin (/admin/clients) add a *confidential* application with:
#   Redirect URI:             https://doughmination.uk/v2/plural/auth/sso/callback
#   Post-logout redirect URI: https://doughmination.co.uk/
# The non-secret bits (SSO_ISSUER / REDIRECT_URI / SCOPES / POST_LOGIN_URL /
# POST_LOGOUT_REDIRECT_URI) live in wrangler.jsonc vars. In production:
#   wrangler secret put SSO_CLIENT_ID
#   wrangler secret put SSO_CLIENT_SECRET
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# OPTIONAL local overrides (otherwise inherited from wrangler.jsonc vars):
# SSO_ISSUER=http://localhost:8787
# SSO_REDIRECT_URI=http://localhost:8789/v2/plural/auth/sso/callback
# SSO_POST_LOGIN_URL=http://localhost:3000/user/login/callback
# SSO_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/

# The initial owner account (ADMIN_USERNAME / ADMIN_DISPLAY_NAME in
# wrangler.jsonc) is seeded on first request with no password. It becomes
# usable the first time that username signs in through the SSO. Accounts that
# were linked to PocketID are taken over the same way, once: the first SSO
# sign-in with a matching username re-links them to the SSO.

# MANUAL bot token for /v2/plural/bot/* — nothing is generated any more.
# Give this exact value to the Discord bot as DOUGH_API_TOKEN.
DOUGH_BOT_TOKEN=

# MANUAL battery-report key(s), comma-separated. Devices send it as the
# `X-Battery-Key` header to POST /v2/battery.
BATTERY_API_KEYS=

# ---- contribapi (/v2/contribapi) — merged git contribution heatmaps --------
# Codeberg/Forgejo needs no token for the public heatmap endpoint.
CODEBERG_USERNAME=
# GitHub needs a token. A fine-grained PAT with read access is enough for the
# contribution calendar. https://github.com/settings/personal-access-tokens
GITHUB_USERNAME=
GITHUB_TOKEN=

# ---- /v2/burst — purge ALL Cloudflare cache --------------------------------
# Cloudflare API token. /v2/burst lists every zone this token can see (across
# every account it has access to, including the account that owns this Worker)
# and purges everything on each. Create at My Profile > API Tokens with:
#   Zone > Zone       : Read
#   Zone > Cache Purge: Purge
# Production: `wrangler secret put CF_API_TOKEN`.
# WARNING: the endpoint is unauthenticated — anyone who loads /v2/burst nukes
# all cache. Leave blank to disable (route returns code: CF_API_TOKEN ...).
CF_API_TOKEN=
